[
  {
    "name": "longest name sets the byte count",
    "input": {
      "template": "안녕 #{이름}님",
      "variables": {
        "이름": [
          "김",
          "홍길동입니다"
        ]
      }
    },
    "expected": {
      "worst": {
        "이름": "홍길동입니다"
      },
      "rendered": "안녕 홍길동입니다님",
      "bytes": 19,
      "channel": "SMS",
      "overLimit": false,
      "encodable": true,
      "shortestBytes": 9,
      "shortestChannel": "SMS"
    }
  },
  {
    "name": "worst value crosses the sms limit",
